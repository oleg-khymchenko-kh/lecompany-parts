NODE_ENV=development
HOST=127.0.0.1
PORT=3011

# MySQL. On production this points at the local instance over the socket/loopback.
DATABASE_URL="mysql://parts:CHANGE_ME@127.0.0.1:3306/parts_prod"

# Public origin of the front end.
SITE_URL=http://localhost:3010
# Leave empty in development; on production it lets the cookie cover the host.
COOKIE_DOMAIN=
SESSION_TTL_DAYS=30

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="LE Company Parts <no-reply@parts.lecompany.co.uk>"
