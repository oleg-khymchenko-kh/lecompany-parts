NODE_ENV=development
HOST=127.0.0.1
PORT=3011

# MySQL. On production this points at the local instance over loopback.
DATABASE_URL="mysql://parts_user:CHANGE_ME@127.0.0.1:3306/parts_prod"
# Prisma Migrate only — a scratch schema it diffs against.
SHADOW_DATABASE_URL="mysql://parts_user:CHANGE_ME@127.0.0.1:3306/parts_prod_shadow"

# Public origin of the front end.
SITE_URL=http://localhost:3010
# Leave empty in development; on production it scopes the session cookie.
COOKIE_DOMAIN=
SESSION_TTL_DAYS=30

# sk_… — the SECRET key, not the publishable one.
STRIPE_SECRET_KEY=sk_test_...
# whsec_… — issued by Stripe when the webhook endpoint is created, and shown
# only once. Not interchangeable with either API key.
STRIPE_WEBHOOK_SECRET=whsec_...
# pk_… — safe to expose; kept here only so both halves live in one place.
STRIPE_PUBLISHABLE_KEY=pk_test_...

SENDGRID_API_KEY=
# Must be an address SendGrid will accept: either a verified single sender or
# any address on an authenticated domain.
MAIL_FROM="LE Company Parts <office@lecompany.co.uk>"
# Optional blind copy of every outgoing message.
MAIL_BCC=
